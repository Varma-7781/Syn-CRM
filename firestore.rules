rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // ENTERPRISE ACCESS CONTROL & RBAC HELPERS
    // ==========================================
    
    // Verifies client has an active Firebase Authentication session
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Safely checks whether user profile document exists
    function hasUserProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Fetches the caller's Firestore user profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Enforces strict role check via verified Firestore document.
    // Explicitly avoids insecure email regex heuristics.
    function isAdmin() {
      return hasUserProfile() && getUserData().get('role', '') == 'admin';
    }

    // Verifies whether caller is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifies whether caller is the assigned sales representative
    function isAssignedRep(leadData) {
      return isAuthenticated() && (
        leadData.get('assignedTo', '') == request.auth.uid ||
        (hasUserProfile() && leadData.get('assignedToName', '') == getUserData().get('name', '')) ||
        (hasUserProfile() && leadData.get('rep', '') == getUserData().get('name', ''))
      );
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Authenticated team members can read team profiles for assignment and scorecards
      allow read: if isAuthenticated();

      // Only administrators can create users, or a user creating their own profile strictly as 'sales'
      allow create: if isAuthenticated() && (
        isAdmin() || (
          isOwner(userId) &&
          request.resource.data.get('role', '') == 'sales' &&
          request.resource.data.get('id', '') == userId
        )
      );

      // Users may update their own contact details, but CANNOT escalate their role or modify protected metadata.
      // Only existing admins can change user roles and department quotas.
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isOwner(userId) &&
          request.resource.data.get('role', '') == resource.data.get('role', '') &&
          request.resource.data.get('id', '') == resource.data.get('id', '') &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id', 'createdBy'])
        )
      );

      // Strictly restrict user deletion to administrators
      allow delete: if isAdmin();
    }

    // ==========================================
    // LEADS COLLECTION
    // ==========================================
    match /leads/{leadId} {
      // Authenticated team members can read leads for pipeline coordination and real-time synchronization
      allow read: if isAuthenticated();

      // Authenticated team members can create leads (manual entry or batch import)
      allow create: if isAuthenticated() && (
        request.resource.data.get('companyName', '') is string ||
        request.resource.data.get('company', '') is string
      );

      // Admins can update any lead; assigned reps can update their leads (but cannot reassign ownership);
      // Non-assigned users can ONLY update specific follow-up and interest status transition fields.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isAssignedRep(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTo', 'assignedToName', 'rep'])
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'followUpStatus', 'followUpRemindedAt', 'followUpCompletedAt', 'followUpOverdueReason',
          'status', 'interestedAt', 'interestedBy', 'interestedByName', 'lastContact', 'updatedAt'
        ])
      );

      // Only administrators can permanently delete leads
      allow delete: if isAdmin();
    }

    // ==========================================
    // TARGETS COLLECTION
    // ==========================================
    match /targets/{targetId} {
      // Team members can view quotas for performance metrics and cockpit meters
      allow read: if isAuthenticated();

      // Only administrators can set or modify sales target quotas
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // ACTIVITIES COLLECTION
    // ==========================================
    match /activities/{activityId} {
      // Authenticated team members can read activity logs
      allow read: if isAuthenticated();

      // Authenticated team members can log calls, notes, or interactions under their own UID, or admin
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid || isAdmin()
      );

      // Admins or activity authors can update/delete their own activity logs without reassigning author
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('userId', '') == resource.data.get('userId', '')
      );

      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.get('userId', '') == request.auth.uid
      );
    }

    // Default deny all other unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
